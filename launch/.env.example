# Path to the payer / pool-creator keypair json (solana-keygen format).
KEYPAIR_PATH=/absolute/path/to/devnet-keypair.json

# Devnet by default. Any mainnet RPC also requires I_UNDERSTAND_NO_BACKSIES=yes.
RPC_URL=https://api.devnet.solana.com

# Where unsold leftover base tokens would go. `leftover` is 0 in the config so
# nothing is ever sent here, but the program rejects the all-zero pubkey.
LEFTOVER_RECEIVER=

# Who can claim trading fees. REQUIRED -- launch.js refuses to run without it.
#
# This address does two jobs and both are permanent:
#   1. claims bonding-curve-phase fees (0.9-9.7 SOL, one time), and
#   2. OWNS THE MIGRATED LP POSITION, so it claims all post-graduation fees
#      (~0.4% of volume, forever). Verified on mainnet migration 48YvT8fe...
#
# It is written into an immutable config and can never be changed. Losing this
# key loses all income permanently. Use a hardware wallet or a multisig.
FEE_CLAIMER=

# Required only for a mainnet --send. Everything this config sets is permanent.
# I_UNDERSTAND_NO_BACKSIES=yes
